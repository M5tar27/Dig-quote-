OPENAI_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Two paid tiers — Starter ($49/mo, 30 bids) and Pro ($149/mo, unlimited). Create both
# recurring Prices in Stripe and paste their price ids here. The free plan has no price id.
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Twilio Verify (SMS code) + Lookup (VOIP detection) gate the free plan's one bid to one
# real phone number per business. All four are required together — see lib/config.ts's
# isTwilioConfigured(). Without them, the free-bid phone-verification step in the quote
# wizard can't be reached and free-plan signups can't generate their one bid.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Any long random string, e.g. `openssl rand -hex 32`. Phone numbers are hashed with this
# as an HMAC key before being stored, instead of a bare SHA-256 hash — plain E.164 numbers
# are low-entropy enough to be brute-forced back from an unsalted hash by anyone with
# database access. Keep this secret out of source control and don't rotate it casually:
# rotating it invalidates every already-recorded verified_phones row.
PHONE_HASH_SECRET=

RESEND_API_KEY=
# Optional. Defaults to "DigQuote <onboarding@resend.dev>" if unset — that address can only
# send to your own Resend account email (good for testing "Email to Client" end to end), not
# to real clients. Once you verify your own domain in Resend, set this to something like:
# RESEND_FROM_EMAIL="DigQuote <quotes@yourdomain.com>"
RESEND_FROM_EMAIL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
